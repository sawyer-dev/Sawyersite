---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/content/EntryCard.astro';
import SectionHeading from '../components/content/SectionHeading.astro';
import { roles, snapshot } from '../data/profile';
import { site } from '../data/site';
import { generate, seedRow, toSvgPath } from '../lib/automaton';
import { getApps, getHobbies, getProjects } from '../lib/collections';
import { formatYearSpan } from '../lib/content-utils';
import { url } from '../lib/urls';

const current = roles.find((r) => r.current) ?? roles[0]!;
const [projects, apps, hobbies] = await Promise.all([getProjects(), getApps(), getHobbies()]);
const featuredProjects = projects.filter((p) => p.data.featured).slice(0, 3);
const featuredApps = apps.filter((a) => a.data.featured).slice(0, 2);
const hobbyPreview = hobbies.slice(0, 3);

const HERO_COLS = 61;
const HERO_ROWS = 34;
const heroPath = toSvgPath(
  generate(110, HERO_COLS, HERO_ROWS, seedRow(HERO_COLS, 'single', Math.random, HERO_COLS - 2)),
);
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">
          {site.role} · {site.location}
        </p>
        <h1 id="hero-title">Sawyer Knowles</h1>
        <p class="hero__lead">
          I build full-stack web software, currently with Angular, TypeScript and .NET at SS&amp;C
          Advent. Before that I prototyped XR and glasses-free 3D experiences for Meta Reality Labs.
        </p>
        <div class="btn-row hero__actions">
          <a class="btn btn--primary" href={url('projects/')}>
            View projects
          </a>
          <a class="btn btn--ghost" href={url('experience/')}>
            Experience
          </a>
        </div>
        <ul class="hero__links">
          <li>
            <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>Email</a>
          </li>
          {site.links.github && (
            <li>
              <a href={site.links.github} target="_blank" rel="noopener noreferrer">
                GitHub<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          )}
          {site.links.resume && (
            <li>
              <a href={url(site.links.resume)}>Résumé</a>
            </li>
          )}
        </ul>
      </div>

      <figure class="hero__art">
        <svg
          viewBox={`0 0 ${HERO_COLS} ${HERO_ROWS}`}
          preserveAspectRatio="xMidYMid slice"
          role="img"
          aria-label="Decorative pattern generated by the Rule 110 cellular automaton"
          shape-rendering="crispEdges"
        >
          <path d={heroPath}></path>
        </svg>
        <figcaption>
          Rule 110, generated while this page was built.
          <a href={url('apps/rule-explorer/')}>Explore other rules</a>
        </figcaption>
      </figure>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="section" aria-labelledby="work-heading">
      <div class="container">
        <SectionHeading
          title="Selected work"
          id="work-heading"
          eyebrow="Projects"
          linkLabel="All projects"
          linkHref={url('projects/')}
        />
        <ul class="grid">
          {featuredProjects.map((p) => (
            <li>
              <EntryCard
                href={url(`projects/${p.id}/`)}
                title={p.data.title}
                summary={p.data.summary}
                status={p.data.status}
                meta={[formatYearSpan(p.data.startYear, p.data.year)]}
                tags={p.data.technologies}
                image={p.data.thumbnail}
                imageAlt={p.data.thumbnailAlt}
                cta="Read the write-up"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--subtle" aria-labelledby="snapshot-heading">
    <div class="container snapshot">
      <div class="snapshot__intro">
        <SectionHeading title="Professional snapshot" id="snapshot-heading" eyebrow="Now" />
        <p class="snapshot__role">
          <strong>{current.title.split(' — ')[0]}</strong>
          <span>
            {current.employer} · {current.dates}
          </span>
        </p>
        <p class="snapshot__summary">{current.summary}</p>
        <a class="link-arrow" href={url('experience/')}>
          Full experience
        </a>
      </div>
      <ul class="snapshot__stats">
        {snapshot.map((s) => (
          <li>
            <p class="stat__figure">{s.figure}</p>
            <p class="stat__label">{s.label}</p>
            <p class="stat__detail">{s.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {featuredApps.length > 0 && (
    <section class="section" aria-labelledby="playground-heading">
      <div class="container">
        <SectionHeading
          title="Interactive playground"
          id="playground-heading"
          eyebrow="Apps"
          linkLabel="All apps"
          linkHref={url('apps/')}
        />
        <p class="playground__text">
          Small tools that run entirely in your browser. They load only when opened and are labelled
          honestly as prototypes or experiments.
        </p>
        <ul class="grid grid--wide">
          {featuredApps.map((a) => (
            <li>
              <EntryCard
                href={url(`apps/${a.id}/`)}
                title={a.data.title}
                summary={a.data.summary}
                status={a.data.status}
                highlight={a.data.interaction}
                image={a.data.thumbnail}
                imageAlt={a.data.thumbnailAlt}
                cta="Open app"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {hobbyPreview.length > 0 && (
    <section class="section section--subtle" aria-labelledby="interests-heading">
      <div class="container">
        <SectionHeading
          title="Beyond the keyboard"
          id="interests-heading"
          eyebrow="Hobbies"
          linkLabel="All hobbies"
          linkHref={url('hobbies/')}
        />
        <ul class="grid">
          {hobbyPreview.map((h) => (
            <li>
              <EntryCard
                href={url(`hobbies/${h.id}/`)}
                title={h.data.title}
                summary={h.data.summary}
                status={h.data.status}
                image={h.data.thumbnail}
                imageAlt={h.data.thumbnailAlt}
                cta="Read more"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="contact-heading">
    <div class="container">
      <div class="contact">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 id="contact-heading">Let's talk</h2>
          <p class="contact__text">
            Hiring, collaborating, or curious about something here? Email is the quickest way to
            reach me.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>
            Email me
          </a>
          <a
            class="btn btn--ghost"
            href={site.links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-8);
    border-bottom: 1px solid var(--border);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .hero h1 {
    font-size: var(--text-hero);
    letter-spacing: -0.03em;
  }

  .hero__lead {
    max-width: 38rem;
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    list-style: none;
  }

  .hero__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .hero__art {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .hero__art svg {
    width: 100%;
    max-height: 22rem;
    aspect-ratio: 61 / 34;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--code-bg);
  }

  .hero__art path {
    fill: #4cc066;
  }

  .hero__art figcaption {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (min-width: 56rem) {
    .hero {
      padding-block: var(--space-8) var(--space-9);
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    list-style: none;
  }

  .grid--wide {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }

  .playground__text {
    max-width: 52ch;
    margin: calc(-1 * var(--space-3)) 0 var(--space-6);
    color: var(--text-muted);
  }

  .snapshot {
    display: grid;
    gap: var(--space-7);
  }

  .snapshot__role {
    display: grid;
    gap: 0.125rem;
  }

  .snapshot__role span {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .snapshot__summary {
    margin-block: var(--space-3) var(--space-4);
    max-width: 44ch;
    color: var(--text-muted);
  }

  .snapshot__stats {
    display: grid;
    gap: var(--space-5);
    list-style: none;
  }

  .snapshot__stats li {
    padding-left: var(--space-4);
    border-left: 3px solid var(--mark);
  }

  .stat__figure {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.1;
  }

  .stat__label {
    font-weight: 600;
  }

  .stat__detail {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (min-width: 56rem) {
    .snapshot {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5) var(--space-7);
    padding-top: var(--space-6);
    border-top: 3px solid var(--mark);
  }

  .contact h2 {
    margin-top: var(--space-2);
  }

  .contact__text {
    max-width: 40ch;
    margin-top: var(--space-2);
    color: var(--text-muted);
  }
</style>
