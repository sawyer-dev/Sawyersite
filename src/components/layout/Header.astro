---
import { nav, site } from '../../data/site';
import { sectionOf, url } from '../../lib/urls';
import ThemeToggle from './ThemeToggle.astro';

const section = sectionOf(Astro.url.pathname, import.meta.env.BASE_URL);
const cta = site.links.resume
  ? { label: 'Résumé', href: url(site.links.resume), external: false }
  : { label: 'Contact', href: `mailto:${site.email}`, external: false };
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('')}>
      <img class="brand__mark" src={url('favicon.svg')} alt="" width="32" height="32" />
      <span class="brand__name">{site.name}</span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a
              class="site-nav__link"
              href={url(item.href)}
              aria-current={item.match === section ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary site-nav__cta" href={cta.href}>
        {cta.label}
      </a>
    </nav>

    <div class="site-header__tools">
      <ThemeToggle />
      <a class="btn btn--primary header-cta" href={cta.href}>
        {cta.label}
      </a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-toggle
      >
        <span class="menu-toggle__label">Menu</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path
            class="menu-toggle__open"
            d="M4 7h16M4 12h16M4 17h16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          ></path>
          <path
            class="menu-toggle__close"
            d="M6 6l12 12M18 6L6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand__mark {
    display: block;
    width: 2rem;
    height: 2rem;
    flex: none;
    transition: transform var(--duration) var(--ease);
  }

  .brand:hover .brand__mark {
    transform: translate(-1px, -1px);
  }

  .site-nav__list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .site-nav__link:hover {
    color: var(--text);
    border-bottom-color: var(--border-strong);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--text);
    font-weight: 650;
    border-bottom-color: var(--mark);
  }

  .site-nav__cta {
    display: none;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header-cta {
    display: none;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    background: transparent;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .menu-toggle:hover {
    border-color: var(--accent);
  }

  .menu-toggle__close,
  .menu-toggle[aria-expanded='true'] .menu-toggle__open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__close {
    display: block;
  }

  /* Desktop: inline navigation and a call to action */
  @media (min-width: 56rem) {
    .site-nav {
      display: flex;
      margin-left: auto;
    }

    .header-cta {
      display: inline-flex;
    }
  }

  /* Without JavaScript the navigation stays visible and wraps instead of collapsing. */
  @media (max-width: 55.9375rem) {
    :global(html:not(.js)) .site-header {
      position: static;
      height: auto;
    }

    :global(html:not(.js)) .site-header__inner {
      flex-wrap: wrap;
      padding-block: var(--space-2);
    }

    :global(html:not(.js)) .site-nav {
      order: 3;
      width: 100%;
    }

    :global(html:not(.js)) .site-nav__list {
      flex-wrap: wrap;
    }

    :global(html.js) .menu-toggle {
      display: inline-flex;
    }

    :global(html.js) .site-nav {
      display: none;
      position: absolute;
      inset: var(--header-height) 0 auto 0;
      max-height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      padding: var(--space-4) max(var(--gutter), env(safe-area-inset-right)) var(--space-5)
        max(var(--gutter), env(safe-area-inset-left));
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    :global(html.js) .site-nav[data-open] {
      display: block;
    }

    :global(html.js) .site-nav__list {
      flex-direction: column;
      gap: 0;
    }

    :global(html.js) .site-nav__link {
      width: 100%;
      min-height: 3rem;
      font-size: var(--text-base);
      border-bottom: 1px solid var(--border);
    }

    :global(html.js) .site-nav__link[aria-current='page'] {
      border-left: 3px solid var(--mark);
      padding-left: var(--space-3);
    }

    :global(html.js) .site-nav__cta {
      display: flex;
      margin-top: var(--space-4);
    }
  }

  @media (max-width: 22rem) {
    .menu-toggle__label {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  const desktop = window.matchMedia('(min-width: 56rem)');

  function setOpen(open: boolean) {
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.toggleAttribute('data-open', open);
  }

  if (toggle && nav) {
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!nav.contains(target) && !toggle.contains(target)) setOpen(false);
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    desktop.addEventListener('change', () => setOpen(false));
    window.addEventListener('pageshow', () => setOpen(false));
  }
</script>
