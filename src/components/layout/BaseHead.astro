---
import { site } from '../../data/site';
import { url, absoluteUrl } from '../../lib/urls';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  image?: string;
}

const {
  title,
  description,
  type = 'website',
  noindex = false,
  image = 'og-default.png',
} = Astro.props;

const isHome = Astro.url.pathname === url('');
const fullTitle = isHome ? title : `${title} · ${site.shortName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = absoluteUrl(image, Astro.site!);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#fcfffc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#040f0f" media="(prefers-color-scheme: dark)" />
<meta name="generator" content={Astro.generator} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
<link rel="sitemap" href={url('sitemap-index.xml')} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Sawyer Knowles — full-stack software engineer" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Applies the saved or system theme before first paint to avoid a flash. -->
<script is:inline>
  (function () {
    const root = document.documentElement;
    root.classList.add('js');
    let theme = null;
    try {
      theme = localStorage.getItem('theme');
    } catch {
      theme = null;
    }
    if (theme !== 'light' && theme !== 'dark') {
      theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    root.setAttribute('data-theme', theme);
  })();
</script>
