---
import type { Role } from '../../data/profile';

interface Props {
  role: Role;
  headingLevel?: 'h2' | 'h3';
}

const { role, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<article class="role">
  <header class="role__head">
    <p class="role__dates">
      {role.dates}
      {role.current && <span class="role__now">Current</span>}
    </p>
    <Heading class="role__employer">{role.employer}</Heading>
    <p class="role__title">{role.title}</p>
    {role.client && <p class="role__client">Client: {role.client}</p>}
  </header>
  <div class="role__body">
    <p class="role__summary">{role.summary}</p>
    <ul class="role__highlights">
      {role.highlights.map((h) => (
        <li>{h}</li>
      ))}
    </ul>
    {role.technologies.length > 0 && (
      <ul class="tag-list" aria-label="Technologies">
        {role.technologies.map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .role {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .role:first-child {
    border-top: 3px solid var(--mark);
  }

  .role__dates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .role__now {
    padding: 0 0.5rem;
    border: 1px solid var(--mark);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .role__employer {
    margin-top: var(--space-2);
    font-size: var(--text-2xl);
  }

  .role__title {
    margin-top: var(--space-1);
    font-weight: 600;
  }

  .role__client {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .role__body {
    display: grid;
    gap: var(--space-4);
    max-width: 62ch;
  }

  .role__summary {
    font-size: var(--text-lg);
  }

  .role__highlights {
    display: grid;
    gap: var(--space-3);
    padding-left: 1.25rem;
  }

  .role__highlights li::marker {
    color: var(--mark);
  }

  @media (min-width: 56rem) {
    .role {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>
