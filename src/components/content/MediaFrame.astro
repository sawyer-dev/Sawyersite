---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** An imported image (optimised) or a URL string. */
  src: ImageMetadata | string;
  /** Required. Use "" only for purely decorative images. */
  alt: string;
  caption?: string;
  /** Needed only when `src` is a string. */
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
}

const { src, alt, caption, width, height, loading = 'lazy' } = Astro.props;
const isMeta = typeof src !== 'string';
---

<figure class="media">
  {isMeta ? (
    <Image
      src={src}
      alt={alt}
      loading={loading}
      decoding="async"
      widths={[480, 800, 1200]}
      sizes="(min-width: 48rem) 48rem, 95vw"
    />
  ) : (
    <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .media {
    margin: var(--space-5) 0;
  }

  .media :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
