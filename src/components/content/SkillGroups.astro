---
import type { SkillGroup } from '../../data/profile';

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<dl class="skills">
  {groups.map((g) => (
    <div class="skills__group">
      <dt>{g.label}</dt>
      <dd>
        <ul class="tag-list">
          {g.items.map((item) => (
            <li class="tag">{item}</li>
          ))}
        </ul>
      </dd>
    </div>
  ))}
</dl>

<style>
  .skills {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  .skills__group {
    display: grid;
    gap: var(--space-2);
  }

  dt {
    font-weight: 650;
  }

  dd {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .skills__group {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-5);
      align-items: baseline;
    }
  }
</style>
