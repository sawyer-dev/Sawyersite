---
import type { ImageMetadata } from 'astro';
import StatusBadge from '../ui/StatusBadge.astro';
import Thumb from '../ui/Thumb.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  status?: string;
  /** Short facts shown above the title, e.g. year or role. */
  meta?: string[];
  tags?: string[];
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  /** Highlighted line, e.g. the main interaction of an app. */
  highlight?: string;
  cta?: string;
  headingLevel?: 'h2' | 'h3';
  /** Hide the thumbnail for compact lists. */
  compact?: boolean;
}

const {
  href,
  title,
  summary,
  status,
  meta = [],
  tags = [],
  image,
  imageAlt,
  highlight,
  cta,
  headingLevel = 'h3',
  compact = false,
} = Astro.props;
const Heading = headingLevel;
---

<article class="card">
  {!compact && <Thumb image={image} alt={imageAlt} seed={title} />}
  <div class="card__body">
    <p class="card__meta">
      {status && <StatusBadge status={status} />}
      {meta.map((m) => (
        <span>{m}</span>
      ))}
    </p>
    <Heading class="card__title">
      <a class="card__link" href={href}>
        {title}
      </a>
    </Heading>
    <p class="card__summary">{summary}</p>
    {highlight && <p class="card__highlight">{highlight}</p>}
    {tags.length > 0 && (
      <ul class="tag-list" aria-label="Technologies and topics">
        {tags.map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    )}
    {cta && (
      <p class="card__cta" aria-hidden="true">
        {cta}
      </p>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    padding: var(--space-5);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .card__meta:empty {
    display: none;
  }

  .card__title {
    font-size: var(--text-xl);
  }

  /* The title link stretches over the whole card so the card is one target. */
  .card__link {
    color: var(--text);
    text-decoration: none;
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card:has(.card__link:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .card__summary {
    color: var(--text-muted);
  }

  .card__highlight {
    padding-left: var(--space-3);
    border-left: 3px solid var(--mark);
    font-size: var(--text-sm);
  }

  .card__cta {
    margin-top: auto;
    padding-top: var(--space-2);
    font-weight: 600;
    color: var(--link);
  }

  .card__cta::after {
    content: ' →';
  }
</style>
