---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
  label?: string;
}

const { images, label = 'Image gallery' } = Astro.props;

const items = await Promise.all(
  images.map(async (img) => ({
    alt: img.alt,
    caption: img.caption ?? '',
    thumb: await getImage({ src: img.src, width: 480, height: 320, fit: 'cover' }),
    full: await getImage({ src: img.src, width: Math.min(img.src.width, 1800) }),
  })),
);
---

<gallery-lightbox class="gallery">
  <ul class="gallery__grid" aria-label={label}>
    {items.map((item, i) => (
      <li>
        <button
          type="button"
          class="gallery__open"
          data-index={i}
          aria-label={`Open image ${i + 1} of ${items.length}: ${item.alt || item.caption}`}
        >
          <img
            src={item.thumb.src}
            width={item.thumb.attributes.width}
            height={item.thumb.attributes.height}
            alt={item.alt}
            loading="lazy"
            decoding="async"
          />
        </button>
      </li>
    ))}
  </ul>

  <dialog class="gallery__dialog" aria-label={label}>
    <div class="gallery__bar">
      <p class="gallery__count" aria-live="polite" data-count></p>
      <button type="button" class="gallery__btn" data-close>
        Close
      </button>
    </div>
    <figure class="gallery__figure">
      <img data-full alt="" />
      <figcaption data-caption></figcaption>
    </figure>
    <div class="gallery__nav">
      <button type="button" class="gallery__btn" data-prev>
        ← Previous
      </button>
      <button type="button" class="gallery__btn" data-next>
        Next →
      </button>
    </div>
  </dialog>

  <script
    type="application/json"
    data-items
    set:html={JSON.stringify(
      items.map((i) => ({ src: i.full.src, alt: i.alt, caption: i.caption })),
    )}
  />
</gallery-lightbox>

<style>
  .gallery {
    display: block;
    margin: var(--space-5) 0;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--space-3);
    list-style: none;
  }

  .gallery__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: border-color var(--duration) var(--ease);
  }

  .gallery__open:hover {
    border-color: var(--accent);
  }

  .gallery__open img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .gallery__dialog {
    width: min(64rem, 100vw);
    max-width: 100vw;
    max-height: 100dvh;
    margin: auto;
    padding: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
  }

  .gallery__dialog::backdrop {
    background: rgb(4 15 15 / 82%);
  }

  .gallery__bar,
  .gallery__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .gallery__bar {
    margin-bottom: var(--space-3);
  }

  .gallery__nav {
    margin-top: var(--space-3);
  }

  .gallery__count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .gallery__btn {
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    background: transparent;
    font-weight: 600;
  }

  .gallery__btn:hover {
    border-color: var(--accent);
  }

  .gallery__figure {
    margin: 0;
    touch-action: pan-y;
  }

  .gallery__figure img {
    width: 100%;
    max-height: 70dvh;
    object-fit: contain;
  }

  .gallery__figure figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .gallery__figure figcaption:empty {
    display: none;
  }
</style>

<script>
  interface Item {
    src: string;
    alt: string;
    caption: string;
  }

  class GalleryLightbox extends HTMLElement {
    private items: Item[] = [];
    private index = 0;
    private opener: HTMLElement | null = null;

    connectedCallback() {
      const data = this.querySelector('script[data-items]');
      this.items = data?.textContent ? (JSON.parse(data.textContent) as Item[]) : [];
      const dialog = this.querySelector('dialog')!;
      const figure = dialog.querySelector('figure')!;

      this.querySelectorAll<HTMLButtonElement>('.gallery__open').forEach((btn) =>
        btn.addEventListener('click', () => {
          this.opener = btn;
          this.show(Number(btn.dataset.index));
          dialog.showModal();
        }),
      );
      dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
      dialog
        .querySelector('[data-prev]')!
        .addEventListener('click', () => this.show(this.index - 1));
      dialog
        .querySelector('[data-next]')!
        .addEventListener('click', () => this.show(this.index + 1));
      dialog.addEventListener('close', () => this.opener?.focus());
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') this.show(this.index - 1);
        if (e.key === 'ArrowRight') this.show(this.index + 1);
      });

      let startX = 0;
      figure.addEventListener('pointerdown', (e) => (startX = e.clientX));
      figure.addEventListener('pointerup', (e) => {
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 50) this.show(this.index + (dx < 0 ? 1 : -1));
      });
    }

    private show(next: number) {
      const count = this.items.length;
      if (count === 0) return;
      this.index = (next + count) % count;
      const item = this.items[this.index]!;
      const img = this.querySelector<HTMLImageElement>('[data-full]')!;
      img.src = item.src;
      img.alt = item.alt;
      this.querySelector('[data-caption]')!.textContent = item.caption;
      this.querySelector('[data-count]')!.textContent = `Image ${this.index + 1} of ${count}`;
    }
  }

  if (!customElements.get('gallery-lightbox'))
    customElements.define('gallery-lightbox', GalleryLightbox);
</script>
