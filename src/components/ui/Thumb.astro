---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { patternFor } from '../../lib/pattern';

interface Props {
  image?: ImageMetadata | undefined;
  alt?: string | undefined;
  /** Seeds the generated placeholder pattern when no image is supplied. */
  seed: string;
  loading?: 'lazy' | 'eager';
}

const { image, alt = '', seed, loading = 'lazy' } = Astro.props;
const pattern = image ? null : patternFor(seed);
---

<div class="thumb">
  {image ? (
    <Image
      src={image}
      alt={alt}
      width={640}
      height={360}
      widths={[320, 480, 640]}
      sizes="(min-width: 60rem) 24rem, 90vw"
      loading={loading}
      decoding="async"
    />
  ) : (
    pattern && (
      <svg
        viewBox={`0 0 ${pattern.cols} ${pattern.rows}`}
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
        focusable="false"
      >
        <path d={pattern.path} fill="currentColor"></path>
      </svg>
    )
  )}
</div>

<style>
  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--code-bg);
    color: #4cc066;
    border-bottom: 1px solid var(--border);
  }

  .thumb :global(img),
  .thumb svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb svg {
    opacity: 0.8;
  }
</style>
